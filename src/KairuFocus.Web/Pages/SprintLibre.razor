@page "/pomodoro/libre"
@attribute [Authorize]
@using KairuFocus.Web.Services
@inject PomodoroApiClient PomodoroApi
@inject TaskApiClient TaskApi
@inject NavigationManager Nav
@implements IAsyncDisposable

<div class="mb-3">
    <a href="/pomodoro" class="btn btn-sm btn-outline-secondary">&larr; Retour</a>
</div>

<h2>Sprint libre</h2>

@if (!_loaded)
{
    <p>Chargement…</p>
}
else
{
    <div class="d-flex flex-column align-items-center gap-3">

        <!-- Configuration (visible seulement avant démarrage) -->
        @if (!_running)
        {
            <div style="width:100%;max-width:480px">
                <div class="mb-3">
                    <label class="form-label">Note (optionnelle)</label>
                    <input class="form-control"
                           placeholder="Ex. daily un peu long, bloqué sur X…"
                           @bind="_note"
                           @bind:event="oninput" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Tâche liée (optionnel)</label>
                    <select class="form-select" @bind="_selectedTaskId">
                        <option value="">— Aucune tâche —</option>
                        @foreach (var task in _availableTasks)
                        {
                            <option value="@task.Id">@task.Title</option>
                        }
                    </select>
                </div>
            </div>
        }

        <!-- Chronomètre count-up -->
        <div class="display-1 font-monospace" style="letter-spacing: 0.05em; color: @(_running ? "#0d6efd" : "#6c757d")">
            @TimeDisplay
        </div>

        @if (_running)
        {
            <div class="text-muted">
                Sprint #@(_todaySprints.Count + 1) en cours
            </div>
        }        <!-- Boutons de contrôle -->
        <div class="d-flex gap-2">
            @if (!_running)
            {
                <button class="btn btn-primary btn-lg" @onclick="StartSprint" disabled="@_starting">
                    @(_starting ? "Démarrage…" : "▶ Démarrer")
                </button>
            }
            else
            {
                <button class="btn btn-success btn-lg" @onclick="FinishSprint">
                    &#10003; Terminer
                </button>
                <button class="btn btn-outline-warning btn-lg" @onclick="InterruptSprint">
                    &#9209; Interrompre
                </button>
            }
        </div>

        @if (_lastCompleted is not null)
        {
            var dur = TimeSpan.FromSeconds(_lastCompleted.DurationSeconds ?? 0);
            var outcomeLabel = _lastCompleted.Status == "Completed" ? "Terminé" : "Interrompu";
            <div class="alert alert-success text-center" style="max-width:360px">
                Sprint enregistré —
                @dur.ToString(@"hh\:mm\:ss") — @outcomeLabel
            </div>
        }

        @if (_errorMessage is not null)
        {
            <div class="alert alert-danger" role="alert" style="max-width:480px">@_errorMessage</div>
        }

        <!-- Historique du jour -->
        @if (_todaySprints.Count > 0)
        {
            <div style="width:100%;max-width:640px" class="mt-3">
                <h5>Sprints du jour (@_todaySprints.Count)</h5>
                <ul class="list-group">
                    @foreach (var sprint in _todaySprints)
                    {
                        var dur = TimeSpan.FromSeconds(sprint.DurationSeconds ?? 0);
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                @if (sprint.LinkedTaskIds.Count > 0)
                                {
                                    var task = _availableTasks.FirstOrDefault(t => t.Id == sprint.LinkedTaskIds[0]);
                                    @if (task is not null)
                                    {
                                        <span class="ms-2 text-muted small">&#128279; @task.Title</span>
                                    }
                                }
                            </div>
                            <span class="d-flex align-items-center gap-2">
                                <span class="font-monospace small">@dur.ToString(@"hh\:mm\:ss")</span>
                                <span class="badge @(sprint.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">
                                    @(sprint.Status == "Completed" ? "Terminé" : "Interrompu")
                                </span>
                            </span>
                        </li>
                    }
                </ul>
            </div>
        }

    </div>
}

<XpToast @ref="_xpToast" />

@code {
    // ── État ──────────────────────────────────────────────────────────────
    private bool _loaded;
    private bool _running;
    private string _note = string.Empty;
    private string _selectedTaskId = string.Empty;
    private Guid? _activeSessionId;
    private int _elapsedSeconds;
    private List<PomodoroSessionDto> _todaySprints = [];
    private List<TaskDto> _availableTasks = [];
    private PomodoroSessionDto? _lastCompleted;
    private string? _errorMessage;
    private bool _starting;
    private CancellationTokenSource? _timerCts;
    private XpToast? _xpToast;

    // ── Computed ──────────────────────────────────────────────────────────
    private string TimeDisplay =>
        $"{_elapsedSeconds / 3600:D2}:{_elapsedSeconds % 3600 / 60:D2}:{_elapsedSeconds % 60:D2}";

    // ── Lifecycle ─────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        _todaySprints = await PomodoroApi.GetTodaySprintSessionsAsync();
        _availableTasks = (await TaskApi.GetAllAsync())
            .Where(t => t.Status != "Done")
            .ToList();

        // Rejoin a free sprint that is already running (started here then navigated away, or
        // redirected from /pomodoro, which refuses to run a free sprint on its countdown).
        // Without this, landing here shows "Démarrer" and the user only recovers their sprint
        // through a 409 and the resync path in StartSprint — a recovery path posing as the
        // nominal one.
        var current = await PomodoroApi.GetCurrentSessionAsync();
        if (current?.Status == "Active" && current.PlannedDurationMinutes == 0 && AdoptActiveSprint(current))
            await StartTimerLoop();

        _loaded = true;
    }

    public async ValueTask DisposeAsync()
    {
        await StopTimer();
    }

    // ── Actions ───────────────────────────────────────────────────────────
    private async Task StartSprint()
    {
        if (_starting) return;
        _starting = true;
        _errorMessage = null;
        _lastCompleted = null;
        StateHasChanged();

        try
        {
            var note = _note.Trim() is { Length: > 0 } n ? n : null;
            var outcome = await PomodoroApi.StartFreeSprintAsync(note);
            if (outcome.Session is null)
            {
                // The POST may have actually succeeded server-side even though we see no
                // session here (HTTP timeout on the way back, or a 409 raised by our own
                // earlier attempt once the 5s server idempotency window has elapsed). Resync
                // with the server before surfacing an error, so the user never gets stuck on
                // an errored screen while a sprint is genuinely running.
                var current = await PomodoroApi.GetCurrentSessionAsync();
                if (current?.Status == "Active")
                {
                    if (AdoptActiveSprint(current))
                    {
                        // Link selected task if any — best-effort, mirrors the success path.
                        if (Guid.TryParse(_selectedTaskId, out var resyncTaskGuid))
                            await PomodoroApi.LinkTaskAsync(resyncTaskGuid);

                        await StartTimerLoop();
                    }

                    return;
                }

                _errorMessage = outcome.Error ?? "Impossible de démarrer le sprint.";
                return;
            }

            if (AdoptActiveSprint(outcome.Session))
            {
                // Link selected task if any
                if (Guid.TryParse(_selectedTaskId, out var taskGuid))
                    await PomodoroApi.LinkTaskAsync(taskGuid);

                await StartTimerLoop();
            }
        }
        finally
        {
            _starting = false;
        }
    }

    /// <summary>Wires the local timer state onto an active session, whether it just got
    /// created or was recovered by resyncing with the server. Refuses to adopt anything other
    /// than a free sprint (<c>PlannedDurationMinutes == 0</c>): a timed Pomodoro session
    /// (sprint/break) adopted here would run as a plain count-up with no decrementing countdown
    /// or end-of-session alarm, <see cref="FinishSprint"/> would complete it as if it were a
    /// free sprint, and <see cref="RefreshAfterSprint"/> would never find it again in
    /// <c>_todaySprints</c> (the today-sprints query filters on <c>PlannedDurationMinutes == 0</c>).
    /// Computes the elapsed time from <see cref="PomodoroSessionDto.StartedAt"/> so an adopted
    /// (already running) session displays its real elapsed time instead of restarting from zero.
    /// Returns <c>true</c> if the session was adopted; <c>false</c> if it was rejected, in which
    /// case <c>_errorMessage</c> explains why and the caller must not start the timer loop.</summary>
    private bool AdoptActiveSprint(PomodoroSessionDto session)
    {
        if (session.PlannedDurationMinutes != 0)
        {
            _errorMessage = "Une session Pomodoro chronométrée est déjà en cours. Rejoins-la depuis « Pomodoro ».";
            return false;
        }

        _activeSessionId = session.Id;
        _elapsedSeconds = session.StartedAt.HasValue
            ? Math.Max(0, (int)(DateTime.UtcNow - session.StartedAt.Value).TotalSeconds)
            : 0;
        _running = true;
        return true;
    }

    private async Task FinishSprint()
    {
        await StopTimer();
        _running = false;
        var xpAwarded = await PomodoroApi.CompleteSessionAsync();
        if (xpAwarded is null) { _errorMessage = "Impossible de terminer le sprint."; return; }
        await RefreshAfterSprint();

        if (xpAwarded.Value > 0 && _xpToast is not null)
            _ = _xpToast.ShowAsync(xpAwarded.Value);
    }

    private async Task InterruptSprint()
    {
        await StopTimer();
        _running = false;
        var ok = await PomodoroApi.InterruptSessionAsync();
        if (!ok) { _errorMessage = "Impossible d'interrompre le sprint."; return; }
        await RefreshAfterSprint();
    }

    private async Task RefreshAfterSprint()
    {
        _errorMessage = null;
        _note = string.Empty;
        _selectedTaskId = string.Empty;
        _activeSessionId = null;
        _todaySprints = await PomodoroApi.GetTodaySprintSessionsAsync();
        _lastCompleted = _todaySprints.LastOrDefault();
        _elapsedSeconds = 0;
        _availableTasks = (await TaskApi.GetAllAsync())
            .Where(t => t.Status != "Done")
            .ToList();
    }

    // ── Timer internals ───────────────────────────────────────────────────
    private async Task StartTimerLoop()
    {
        await StopTimer();
        _timerCts = new CancellationTokenSource();
        var token = _timerCts.Token;

        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            try
            {
                while (await timer.WaitForNextTickAsync(token))
                {
                    _elapsedSeconds++;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException) { }
        }, token);
    }

    private async Task StopTimer()
    {
        if (_timerCts is not null)
        {
            await _timerCts.CancelAsync();
            _timerCts.Dispose();
            _timerCts = null;
        }
    }
}
